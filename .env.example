# Copy to .env and fill in. Never commit .env.

# ── Required in production ───────────────────────────────────────────────────
# Signs the hub's session cookies. Changing it signs everybody out.
#   openssl rand -hex 32
SESSION_SECRET=

# Encrypts every participant's stored broker API key and secret.
#
# KEEP A COPY SOMEWHERE OTHER THAN THIS SERVER. It is not stored in any database — that is the
# point, since a stolen database is then not enough to use anyone's credentials. The flip side is
# that losing it means all twenty-five participants re-enter their keys, and there is no recovery
# path from our side.
#   openssl rand -hex 32
CREDENTIAL_KEY=

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Leave empty for a quick tunnel: no account, no domain, works immediately — but the hostname
# changes every time cloudflared restarts, so anyone holding the old link finds it dead.
#
# Set it for a named tunnel: one stable hostname that survives restarts. Needs a free Cloudflare
# account with a domain added to it. Worth doing before you hand the link to a room of people.
TUNNEL_TOKEN=

# ── Optional ─────────────────────────────────────────────────────────────────
# PORT=5080
# DATA_DIR=./data
# ENGINES_DIR=./engines

# One app process per participant, one port each, assigned at account creation. The range caps
# how many participants a single deployment can hold — 100 by default, which is four times the
# workshop and still a narrow window to scan.
# INSTANCE_PORT_BASE=5100
# INSTANCE_PORT_MAX=5199

# What each participant's two accounts are called in their own app. Per-instance, so this is a
# deployment-wide default rather than anyone's personal setting.
# PORTFOLIO_ICICI=ICICI
# PORTFOLIO_ZERODHA=Zerodha

# Only if the Python engines live somewhere other than engines/, or you want a specific
# interpreter. config/engines.js finds venv/bin or venv/Scripts on its own, then falls back to
# python3 on PATH.
# PYTHON_BIN=/app/engines/venv/bin/python3

# Marks the session cookie Secure. MUST be true behind HTTPS and false on plain http — a Secure
# cookie sent over http is dropped silently by the browser, which presents as "sign in does
# nothing at all" rather than as an error.
# COOKIE_SECURE=false
